{
  "name": "dronesim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-assets.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:mobile": "tsc --noEmit && vite build --mode mobile",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run android:sync && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.2",
    "@capacitor/haptics": "^6.0.3",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
